	<!--Time value below almost in milisecond unless ttl in second-->
	<service_discovery>
                <!--Delay in client side for sending subscribe so that TCP can complete connection establishment-->
		<subscribe_delay>30</subscribe_delay> 
		<!--Ability to receive a SD ucast message-->
		<receive_ucast>true</receive_ucast> 
		<!--ucast-->
		<explicit_init_data>true</explicit_init_data>
		<!--Limitation of ucast per event group can receive event/notifier on-->
		<ucast_limit>2</ucast_limit> 
		<mcast>239.192.255.251</mcast>
		<port>30490</port>
		<sd_endpoint_enable>false</sd_endpoint_enable>
		<initial_delay_min>0</initial_delay_min>
		<initial_delay_max>100</initial_delay_max>
		<repetitions_base_delay>30</repetitions_base_delay>
		<repetitions_max>3</repetitions_max>
		<!--ttl in value of second-->
		<ttl>3</ttl>
		<cyclic_offer_delay>1000</cyclic_offer_delay>
		<request_response_delay_min>10</request_response_delay_min>
		<request_response_delay_max>20</request_response_delay_max>
	</service_discovery>
